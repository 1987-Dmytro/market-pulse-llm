# Copy to .env and fill in. .env is gitignored and must stay that way.

# Telegram MTProto API credentials — my.telegram.org, API development tools.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Session file name, created by scripts/tg_login.py and gitignored.
TELEGRAM_SESSION=marketpulse

# HMAC salt for sender_anon_id in the raw store — raw user ids are never written.
# EXAMPLE ONLY, generate your own:
#   python3 -c "import secrets; print('RAW_STORE_SALT=' + secrets.token_hex(32))" >> .env
# Set it once and never rotate it: a new salt orphans every sender_anon_id
# already in data/raw/, and the same person no longer matches across records.
RAW_STORE_SALT=80ca315f878d8a12e7b8aa084c7e93126c12a8f85274a469dbfe9d9e4685dbb8
